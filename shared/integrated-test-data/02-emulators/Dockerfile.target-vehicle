FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
RUN uv pip install --system --no-cache "confluent-kafka>=2.5,<3" "azure-identity>=1.17,<2"

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY src/mda_emulators/target_vehicle.py /app/target_vehicle.py
USER 65532:65532

ENTRYPOINT ["python", "/app/target_vehicle.py"]
CMD ["--loop"]