{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric-demo.local/contracts/events/command-integration.schema.json",
  "title": "Synthetic Command Integration Event",
  "allOf": [
    {
      "$ref": "../common/event-envelope.schema.json"
    },
    {
      "type": "object",
      "required": ["track_id", "action", "status"],
      "properties": {
        "event_type": {
          "const": "command.integration"
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "TRACK_CORRELATED",
            "SHARED_TRACK_PUBLISHED",
            "CUE_RECEIVED",
            "ABSTRACT_ASSIGNMENT",
            "ASSIGNMENT_ACKNOWLEDGED",
            "PARTICIPATION_REPORTED"
          ]
        },
        "target_instance_id": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACCEPTED", "REJECTED", "COMPLETED", "DELAYED"]
        },
        "processing_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "data_product_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+$"
        }
      }
    }
  ]
}
