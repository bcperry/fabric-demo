{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric-demo.local/contracts/events/instrumentation-observation.schema.json",
  "title": "Synthetic Instrumentation Observation Event",
  "allOf": [
    {
      "$ref": "../common/event-envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "track_id",
        "sensor_modality",
        "measurement_quality",
        "position",
        "clock_offset_ms",
        "sample_state"
      ],
      "properties": {
        "event_type": {
          "const": "instrumentation.observation"
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "sensor_modality": {
          "type": "string",
          "enum": ["RANGE_RECEIVER", "OPTICAL_TRACKER"]
        },
        "measurement_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "position": {
          "type": "object",
          "required": ["x", "y", "z", "coordinate_system"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "z": {"type": "number"},
            "coordinate_system": {
              "const": "FICTIONAL_LOCAL_GRID"
            }
          }
        },
        "clock_offset_ms": {
          "type": "integer",
          "minimum": 0
        },
        "sample_state": {
          "type": "string",
          "enum": ["NOMINAL", "CLOCK_SKEW_OBSERVED", "SPARSE_CONFIRMATION"]
        }
      }
    }
  ]
}