{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric-demo.local/contracts/scenario.schema.json",
  "title": "Synthetic Integrated Defense Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "display_name",
    "seed",
    "time_scale",
    "classification",
    "location_notice",
    "location_bounds",
    "sites",
    "supporting_sources",
    "anomalies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "time_scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "classification": {
      "const": "SYNTHETIC_UNCLASS"
    },
    "location_notice": {
      "const": "SYNTHETIC / NOT FOR NAVIGATION"
    },
    "location_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_latitude",
        "max_latitude",
        "min_longitude",
        "max_longitude",
        "minimum_separation_degrees"
      ],
      "properties": {
        "min_latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "max_latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "min_longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "max_longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "minimum_separation_degrees": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "supporting_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/supportingSource"
      }
    },
    "anomalies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anomaly"
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "synthetic"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "synthetic": {
          "const": true
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_family",
        "instance_id",
        "role",
        "event_profile",
        "sustainment_profile"
      ],
      "properties": {
        "system_family": {
          "type": "string",
          "enum": [
            "TPY2",
            "PATRIOT",
            "THAAD",
            "BATTLE_MANAGEMENT",
            "ARMY_INTEGRATION"
          ]
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "event_profile": {
          "type": "string",
          "enum": ["NORMAL", "DEGRADED", "RECOVERY"]
        },
        "sustainment_profile": {
          "type": "string",
          "enum": ["READY", "LIMITED", "MAINTENANCE"]
        }
      }
    },
    "supportingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "source_instance_id",
        "site_id",
        "role",
        "event_profile"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "enum": [
            "TARGET_RANGE",
            "INTERCEPTOR_RANGE",
            "RANGE_RECEIVER",
            "OPTICAL_TRACKER",
            "GROUND_TRUTH",
            "ENVIRONMENT",
            "INSTRUMENTATION_MONITOR",
            "NETWORK_MONITOR",
            "READINESS_CONTROLLER",
            "OPERATOR_CONTROL",
            "SAFETY_MONITOR"
          ]
        },
        "source_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "event_profile": {
          "type": "string",
          "enum": ["NORMAL", "DEGRADED", "RECOVERY", "ADVISORY"]
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "display_name", "systems"],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "systems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/system"
          }
        }
      }
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anomaly_id",
        "type",
        "target_instance_id",
        "start_offset_seconds",
        "duration_seconds"
      ],
      "properties": {
        "anomaly_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "CLOCK_ALIGNMENT_DELAY",
            "SCHEMA_VERSION_MISMATCH",
            "LATE_EVENT",
            "DUPLICATE_EVENT",
            "MISSING_SEQUENCE"
          ]
        },
        "target_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "start_offset_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
