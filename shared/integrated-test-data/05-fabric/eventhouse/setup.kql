.create-or-alter function with (folder = 'demo07') LatestOperationalStatus(runId:string) {
    SystemStatus
    | where simulation_run_id == runId
    | summarize arg_max(event_time_utc, *) by source_instance_id
    | project source_instance_id, source_system, site_id, readiness_state, operating_state, health_score, metrics
}

.create-or-alter function with (folder = 'demo07') DelayedIntegrationEvents(runId:string) {
    CommandIntegration
    | where simulation_run_id == runId
    | where status == 'DELAYED' or processing_delay_ms > 1000
    | project event_time_utc, track_id, source_instance_id, action, status, processing_delay_ms
}

.create-or-alter function with (folder = 'demo07') EvidenceWindow(runId:string) {
    union
        (InstrumentationHealth | where simulation_run_id == runId | project event_time_utc, source='InstrumentationHealth', detail=strcat(component_id, ':', status), severity=tostring(observed_lag_ms)),
        (NetworkHealth | where simulation_run_id == runId | project event_time_utc, source='NetworkHealth', detail=strcat(circuit_id, ':', status), severity=tostring(latency_ms)),
        (OperatorTestEvent | where simulation_run_id == runId | project event_time_utc, source='OperatorTestEvent', detail=marker, severity=decision),
        (SafetyStatus | where simulation_run_id == runId | project event_time_utc, source='SafetyStatus', detail=condition, severity=recommended_action)
    | order by event_time_utc asc
}
