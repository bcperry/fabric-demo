// Synthetic UNCLASS demo tables for Fabric Eventhouse.

.create-merge table SensorObservation (
    event_id:string,
    event_type:string,
    schema_version:string,
    scenario_id:string,
    simulation_run_id:string,
    test_event_id:string,
    site_id:string,
    source_system:string,
    source_instance_id:string,
    ordering_key:string,
    sequence_number:long,
    event_time_utc:datetime,
    ingest_time_utc:datetime,
    correlation_id:string,
    causation_id:string,
    track_id:string,
    observation_type:string,
    quality:dynamic,
    position:dynamic,
    classification:string,
    synthetic:bool
)

