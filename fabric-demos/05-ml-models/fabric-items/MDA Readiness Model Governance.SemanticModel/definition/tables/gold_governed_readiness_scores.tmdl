table gold_governed_readiness_scores
	lineageTag: 9d3887da-dcc2-424f-9729-b1a890e645e7
	sourceLineageTag: [dbo].[gold_governed_readiness_scores]

	measure 'Scored Observations' = COUNTROWS(gold_governed_readiness_scores)
		formatString: 0

	measure 'Systems Scored' = DISTINCTCOUNT(gold_governed_readiness_scores[system_instance_id])
		formatString: 0

	measure 'Priority Reviews' = CALCULATE(COUNTROWS(gold_governed_readiness_scores), gold_governed_readiness_scores[recommended_review_queue] = "priority-review")
		formatString: 0

	measure 'Priority Rate' = DIVIDE([Priority Reviews], [Scored Observations])
		formatString: 0.0%

	measure 'Pending Analyst Reviews' = CALCULATE(COUNTROWS(gold_governed_readiness_scores), gold_governed_readiness_scores[human_adjudication_status] = "pending-analyst-review")
		formatString: 0

	measure 'Average Priority Probability' = AVERAGE(gold_governed_readiness_scores[model_priority_probability])
		formatString: 0.0%

	measure 'Average Baseline Score' = AVERAGE(gold_governed_readiness_scores[deterministic_baseline_score])
		formatString: 0.0%

	measure 'Model Delta' = [Average Priority Probability] - [Average Baseline Score]
		formatString: +0.0%;-0.0%;0.0%

	measure 'Average Quality Rate' = AVERAGE(gold_governed_readiness_scores[quality_rate])
		formatString: 0.0%

	measure 'Average Freshness Minutes' = DIVIDE(AVERAGE(gold_governed_readiness_scores[track_freshness_seconds]), 60)
		formatString: 0.0

	measure 'Selected Model' = SELECTEDVALUE(gold_governed_readiness_scores[model_name], "Multiple models")

