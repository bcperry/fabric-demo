table gold_current_test_findings
	lineageTag: 0daa28df-20f9-4a4a-a240-8e4d0a461707
	sourceLineageTag: [dbo].[gold_current_test_findings]

	measure 'Open Findings' = COUNTROWS('gold_current_test_findings')
		formatString: 0
		lineageTag: e158851c-1beb-4e78-bfc3-5c24b068c8ad

	measure 'High Findings' = CALCULATE([Open Findings], 'gold_current_test_findings'[severity] = "high")
		formatString: 0
		lineageTag: bdf7d56a-dc5a-4370-bbf3-58e231ab37a3

	measure 'Affected Sources' = DISTINCTCOUNT('gold_stream_finding_evidence'[source_system])
		formatString: 0
		lineageTag: 9dd57657-d98e-487d-b63a-628352267d8a

	measure 'Evidence Coverage' = DIVIDE(DISTINCTCOUNT('gold_stream_finding_evidence'[finding_id]), [Open Findings])
		formatString: 0%
		lineageTag: 96ec228d-bbc6-4fe5-897d-f89042163107

	measure 'Director Review Items' = CALCULATE([Open Findings], 'gold_current_test_findings'[decision_class] = "DIRECTOR REVIEW")
		formatString: 0
		lineageTag: 44f08773-81e1-42b6-84e9-2088ddd27317

	measure 'Watch Items' = CALCULATE([Open Findings], 'gold_current_test_findings'[decision_class] = "WATCH")
		formatString: 0
		lineageTag: 085aa292-07a3-45a9-8722-7d74ec07644c

	measure 'Findings With Attached Records' = FORMAT(DISTINCTCOUNT('gold_stream_finding_evidence'[finding_id]), "0") & "/" & FORMAT([Open Findings], "0")
		lineageTag: 8a3027c4-f411-4d6e-87f4-11a6266cfbbd

