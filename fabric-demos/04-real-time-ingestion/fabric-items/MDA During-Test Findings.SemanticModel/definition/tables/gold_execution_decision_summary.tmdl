table gold_execution_decision_summary
	lineageTag: 5134e780-ce2d-47bb-9db2-c47a8efcb2d6
	sourceLineageTag: [dbo].[gold_execution_decision_summary]

	measure 'Execution Mode' = SELECTEDVALUE('gold_execution_decision_summary'[execution_mode], "MODE UNAVAILABLE")
		lineageTag: 446048c6-6b3d-4d1a-afb2-10fd4bcb6594

	measure 'Test Scope' = SELECTEDVALUE('gold_execution_decision_summary'[test_event_id], "TEST UNAVAILABLE") & " | " & SELECTEDVALUE('gold_execution_decision_summary'[sites], "SITES UNAVAILABLE")
		lineageTag: e8dc4f1a-36f6-4a80-b151-c4de0ea8dfb4

	measure 'Replay Window End' = MAX('gold_execution_decision_summary'[observation_window_end_utc])
		formatString: yyyy-mm-dd hh:mm:ss
		lineageTag: 57409ec2-2c4d-4d7f-9518-005b0da5fa8f

	measure 'Replay Completeness' = FORMAT(MAX('gold_execution_decision_summary'[preserved_event_count]), "0") & " canonical / " & FORMAT(MAX('gold_execution_decision_summary'[raw_record_count]), "0") & " raw records"
		lineageTag: 0393601b-c41b-4bb7-a38c-5654c02955b7

	measure 'Acknowledgment State' = SWITCH(SELECTEDVALUE('gold_execution_decision_summary'[acknowledgment_status], "NOT APPLICABLE"), "UNDETERMINED", "UNDETERMINED | replay ended before deadline " & FORMAT(MAX('gold_execution_decision_summary'[acknowledgment_due_utc]), "yyyy-mm-dd hh:mm:ss"), "PENDING", "PENDING until " & FORMAT(MAX('gold_execution_decision_summary'[acknowledgment_due_utc]), "yyyy-mm-dd hh:mm:ss"), SELECTEDVALUE('gold_execution_decision_summary'[acknowledgment_status], "NOT APPLICABLE"))
		lineageTag: 2aa26b4f-2650-41be-aa8a-3bec3081a498

	measure 'Decision Recommendation' = SELECTEDVALUE('gold_execution_decision_summary'[decision_recommendation], "DECISION UNAVAILABLE")
		lineageTag: 2ae3f5c8-849a-4e34-aacb-ed28fed0fd40

	measure 'Decision Authority' = SELECTEDVALUE('gold_execution_decision_summary'[decision_authority], "AUTHORITY UNAVAILABLE")
		lineageTag: 2734fb4c-d498-42d1-9023-d00cfe4a0dda

	measure 'Visible Scope' = SELECTEDVALUE('gold_execution_decision_summary'[scope_note], "SCOPE UNAVAILABLE")
		lineageTag: d61a774b-9bcb-489b-ac51-bfb4d8df40ae

