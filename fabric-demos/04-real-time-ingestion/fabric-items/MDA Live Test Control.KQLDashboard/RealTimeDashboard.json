    "queries": [
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "RawIntegratedTestEvents\r\n| summarize Events = count()",
            "id": "313cc8c0-26a5-4c62-87f4-0c69b138b100",
            "usedVariables": []
        },
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "SystemStatus\r\n| summarize arg_max(event_time_utc, *) by system_instance_id\r\n| project Source=source_system, Instance=system_instance_id, Readiness=readiness_state, Health=round(health_score * 100, 0), LastEvent=event_time_utc, Sequence=sequence_number\r\n| order by Health asc",
            "id": "ef52c83d-9127-4803-a3fe-8390a11770e9",
            "usedVariables": []
        },
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "union (SensorObservation | project EventTime=observation_time_utc, Series='Sensor quality', Value=quality_score * 100.0), (CommandIntegration | project EventTime=event_time_utc, Series='Command latency (sec)', Value=toreal(processing_delay_ms) / 1000.0), (SystemStatus | project EventTime=event_time_utc, Series=source_system, Value=health_score * 100.0) | where EventTime >= datetime(2026-01-01) | order by EventTime asc",
            "id": "23f6a93a-0ccc-499d-9361-2fa40e6c4048",
            "usedVariables": []
        },
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "CommandIntegration\r\n| summarize DelaySeconds=max(processing_delay_ms) / 1000.0 by action_name\r\n| order by DelaySeconds desc",
            "id": "e8bf8bdd-e684-470d-8abc-60eccea4be44",
            "usedVariables": []
        },
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "EventValidationIssue | project Detected=detected_time_utc, Source=source_system, EventType=event_type, Reason=reason_code, Detail=reason_detail, EventId=event_id | order by Detected desc",
            "id": "5261f73b-050d-43fb-ac67-979605146245",
            "usedVariables": []
        }
    ],
