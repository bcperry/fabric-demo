    "queries": [
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "RawIntegratedTestEvents\r\n| where ingestion_time() >= _startTime and ingestion_time() < _endTime\r\n| summarize RawEnvelopes = count()",
            "id": "313cc8c0-26a5-4c62-87f4-0c69b138b100",
            "usedVariables": ["_startTime", "_endTime"]
        },
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "TestSourceCoverage(_startTime, _endTime)",
            "id": "ef52c83d-9127-4803-a3fe-8390a11770e9",
            "usedVariables": ["_startTime", "_endTime"]
        },
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "CanonicalIntegratedTestEvents(_startTime, _endTime)\r\n| summarize Events=count() by EventTime=bin(EventTime, 10s), Series=strcat(Scenario, ' / ', Run, ' / ', source_system)\r\n| order by EventTime asc",
            "id": "23f6a93a-0ccc-499d-9361-2fa40e6c4048",
            "usedVariables": ["_startTime", "_endTime"]
        },
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "CanonicalIntegratedTestEvents(_startTime, _endTime)\r\n| where event_type == 'command.integration'\r\n| summarize ReportedSeconds=max(toreal(event.processing_delay_ms)) / 1000.0 by Series=strcat(Scenario, ' / ', Run, ' / ', source_system, ' / ', tostring(event.action))\r\n| order by ReportedSeconds desc",
            "id": "e8bf8bdd-e684-470d-8abc-60eccea4be44",
            "usedVariables": ["_startTime", "_endTime"]
        },
        {
            "dataSource": {
                "kind": "inline",
                "dataSourceId": "543b0f63-3aea-47b7-aabc-77337123f857"
            },
            "text": "ClassifyIntegratedTestEvents(RawIntegratedTestEvents)\r\n| extend ReceivedAt=ingestion_time()\r\n| where ReceivedAt >= _startTime and ReceivedAt < _endTime\r\n| where isnotempty(reason_code)\r\n| project ReceivedAt, Scenario=tostring(event.scenario_id), Run=tostring(event.simulation_run_id), Source=source_system, EventType=event_type, Reason=reason_code, EventId=event_id, RawEventTime=event_time_utc\r\n| order by ReceivedAt desc",
            "id": "5261f73b-050d-43fb-ac67-979605146245",
            "usedVariables": ["_startTime", "_endTime"]
        }
    ],
    "embeddedApps": []
