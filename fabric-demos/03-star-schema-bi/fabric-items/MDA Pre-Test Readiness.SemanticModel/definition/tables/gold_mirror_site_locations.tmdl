table gold_mirror_site_locations
	lineageTag: 83bcb18d-eed4-439a-af91-8c1bb03e1a71
	sourceLineageTag: [dbo].[gold_mirror_site_locations]

	measure 'Mirrored Sites' = DISTINCTCOUNT(gold_mirror_site_locations[site_id])
		formatString: 0

	measure 'Mirrored Systems' = SUM(gold_mirror_site_locations[system_count])
		formatString: 0

	measure 'Constrained Mirrored Systems' = SUM(gold_mirror_site_locations[constrained_system_count])
		formatString: 0

	measure 'Locations in Scope' = DISTINCTCOUNT(gold_mirror_site_locations[site_id])
		formatString: 0

	measure 'Participant Systems' = SUM(gold_mirror_site_locations[system_count])
		formatString: 0

	measure 'Participant Readiness Brief' = ```
			VAR TotalSystems = [Participant Systems]
			VAR ConstrainedSystems = SUM(gold_mirror_site_locations[constrained_system_count])
			VAR ReadySystems = TotalSystems - ConstrainedSystems
			RETURN FORMAT(ReadySystems, "#,0") & " ready (" & FORMAT(DIVIDE(ReadySystems, TotalSystems), "0.0%") & ")"
			```

	measure 'Participant Readiness Title' = ```
			VAR TotalSystems = [Participant Systems]
			VAR ConstrainedSystems = SUM(gold_mirror_site_locations[constrained_system_count])
			RETURN "Participant systems | Threshold: 100% | Required: " & FORMAT(TotalSystems, "#,0") & " | Not ready: " & FORMAT(ConstrainedSystems, "#,0")
			```

	measure 'Site Risk Priority' = SWITCH(SELECTEDVALUE(gold_mirror_site_locations[site_risk_level]), "CRITICAL", 4, "HIGH", 3, "MEDIUM", 2, "LOW", 1, 0)
		formatString: 0

	measure 'Site Risk Decision Order' = SWITCH(SELECTEDVALUE(gold_mirror_site_locations[site_risk_level]), "CRITICAL", "1 | CRITICAL", "HIGH", "2 | HIGH", "MEDIUM", "3 | MEDIUM", "LOW", "4 | LOW", "5 | CLEAR")

	measure 'Site Decision Banner' = ```
			"Integrated Defense Rehearsal 001 | 03 Nov 2026 | 1500-1515Z | " &
			IF(
			    [Locations in Scope] < CALCULATE([Locations in Scope], REMOVEFILTERS(gold_mirror_site_locations)),
			    FORMAT([Locations in Scope], "0") & " SITES SELECTED - reset selections to restore all sites",
			    "ALL SITES"
			)
			```

	measure 'Active Site Risks' = SUM(gold_mirror_site_locations[active_risk_count])
		formatString: 0

	measure 'Average Latitude' = AVERAGE(gold_mirror_site_locations[latitude])
		formatString: 0.00000

	measure 'Average Longitude' = AVERAGE(gold_mirror_site_locations[longitude])
		formatString: 0.00000

	measure 'Mirror Source' = SELECTEDVALUE(gold_mirror_site_locations[data_origin], "Azure PostgreSQL -> Fabric mirrored database")

