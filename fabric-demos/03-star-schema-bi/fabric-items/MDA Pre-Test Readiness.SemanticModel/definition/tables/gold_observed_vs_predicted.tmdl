table gold_observed_vs_predicted
	lineageTag: 35e0efa4-4f60-4618-8b19-22ed2061e327
	sourceLineageTag: [dbo].[gold_observed_vs_predicted]

	measure 'Planned Checks' = COUNTROWS(gold_observed_vs_predicted)
		formatString: 0

	measure 'On-Plan Checks' = CALCULATE(COUNTROWS(gold_observed_vs_predicted), gold_observed_vs_predicted[comparison_status] = "ON_PLAN")
		formatString: 0

	measure 'Partial Checks' = CALCULATE(COUNTROWS(gold_observed_vs_predicted), gold_observed_vs_predicted[comparison_status] = "PARTIAL")
		formatString: 0

	measure 'Not-Met Checks' = CALCULATE(COUNTROWS(gold_observed_vs_predicted), gold_observed_vs_predicted[comparison_status] = "NOT_MET")
		formatString: 0

	measure 'Late Evidence' = CALCULATE(COUNTROWS(gold_observed_vs_predicted), gold_observed_vs_predicted[is_late_record] = TRUE())
		formatString: 0

