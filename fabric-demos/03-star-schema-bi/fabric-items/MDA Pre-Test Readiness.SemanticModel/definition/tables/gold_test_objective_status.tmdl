table gold_test_objective_status
	lineageTag: 576ed56c-3242-47e7-927a-25d3e97a2ab2
	sourceLineageTag: [dbo].[gold_test_objective_status]

	measure 'Total Objectives' = DISTINCTCOUNT(gold_test_objective_status[test_objective_id])
		formatString: 0

	measure 'Objectives Met' = ```
			CALCULATE(
			    DISTINCTCOUNT(gold_test_objective_status[test_objective_id]),
			    gold_test_objective_status[objective_status] = "MET"
			)
			```
		formatString: 0

	measure 'Objectives Requiring Attention' = ```
			CALCULATE(
			    DISTINCTCOUNT(gold_test_objective_status[test_objective_id]),
			    gold_test_objective_status[objective_status] <> "MET"
			)
			```
		formatString: 0

