table gold_integrated_readiness
	lineageTag: 97d31413-75c9-4b23-af7d-f2f9a0a73be3
	sourceLineageTag: [dbo].[gold_integrated_readiness]

	measure 'Total Systems' = ```
			CALCULATE(
			    DISTINCTCOUNT(gold_integrated_readiness[system_instance_id]),
			    gold_integrated_readiness[readiness_scope] = "SYSTEM"
			)
			```
		formatString: 0

	measure 'Ready Systems' = ```
			CALCULATE(
			    DISTINCTCOUNT(gold_integrated_readiness[system_instance_id]),
			    gold_integrated_readiness[readiness_scope] = "SYSTEM",
			    gold_integrated_readiness[integrated_readiness_status] = "READY"
			)
			```
		formatString: 0

	measure 'Constrained Systems' = [Total Systems] - [Ready Systems]
		formatString: 0

	measure 'Readiness Percentage' = DIVIDE([Ready Systems], [Total Systems])
		formatString: 0.0%

	measure 'Systems Ready Brief' = FORMAT([Ready Systems], "0") & " / " & FORMAT([Total Systems], "0") & " (" & FORMAT([Readiness Percentage], "0.0%") & ")"

	column readiness_scope
		dataType: string
		lineageTag: 616a2242-36d9-4778-8929-40c8c7bf7dea
		sourceLineageTag: readiness_scope
		summarizeBy: none
		sourceColumn: readiness_scope

		annotation SummarizationSetBy = Automatic

