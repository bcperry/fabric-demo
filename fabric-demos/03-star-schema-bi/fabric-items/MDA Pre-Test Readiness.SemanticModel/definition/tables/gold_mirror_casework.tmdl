table gold_mirror_casework
	lineageTag: be506c79-c2ea-43fc-b0b5-2416584dd8d4
	sourceLineageTag: [dbo].[gold_mirror_casework]

	measure 'Mirrored Active Findings' = DISTINCTCOUNT(gold_mirror_casework[finding_id])
		formatString: 0

	measure 'Mirrored Evidence Records' = SUM(gold_mirror_casework[evidence_count])
		formatString: 0

	measure 'Mirrored Corrective Actions' = SUM(gold_mirror_casework[corrective_action_count])
		formatString: 0

	measure 'Open Mirrored Actions' = SUM(gold_mirror_casework[open_action_count])
		formatString: 0

	measure 'Recovery Actions Open' = SUM(gold_mirror_casework[open_action_count])
		formatString: 0

	measure 'Risk Priority' = SWITCH(SELECTEDVALUE(gold_mirror_casework[severity]), "CRITICAL", 4, "HIGH", 3, "MEDIUM", 2, "LOW", 1, 0)
		formatString: 0

	measure 'Risk Decision Order' = SWITCH(SELECTEDVALUE(gold_mirror_casework[severity]), "CRITICAL", "1 | CRITICAL", "HIGH", "2 | HIGH", "MEDIUM", "3 | MEDIUM", "LOW", "4 | LOW", BLANK())

	measure 'Critical Risks' = COALESCE(CALCULATE(DISTINCTCOUNT(gold_mirror_casework[finding_id]), gold_mirror_casework[severity] = "CRITICAL"), 0)
		formatString: 0

	measure 'High Risks' = CALCULATE(DISTINCTCOUNT(gold_mirror_casework[finding_id]), gold_mirror_casework[severity] = "HIGH")
		formatString: 0

	measure 'Director Recommendation' = ```
			IF(
			    COALESCE([Mirrored Active Findings], 0) > 0,
			    "REVIEW REQUIRED - unresolved findings in selected casework",
			    "NO ACTIVE FINDINGS IN VIEW - approval and completeness not established"
			)
			```

	measure 'Decision Scope Banner' = ```
			"Administrative casework | " &
			IF(
			    ISCROSSFILTERED(gold_mirror_casework),
			    "FILTERED VIEW",
			    "LEAD EVENT"
			)
			& " | Analytical readiness has separate scope"
			```

	measure 'Lead Event Window' = SELECTEDVALUE(gold_mirror_casework[event_name], "Integrated defense rehearsal 001") & " | " & FORMAT(MIN(gold_mirror_casework[planned_start_time_utc]), "dd mmm yyyy HHmm") & "-" & FORMAT(MIN(gold_mirror_casework[planned_end_time_utc]), "HHmm") & "Z"

	measure 'Evidence Current As Of' = IF(ISBLANK(MAX(gold_mirror_casework[source_as_of_utc])), "No casework timestamp in view", "Latest casework record: " & FORMAT(MAX(gold_mirror_casework[source_as_of_utc]), "dd mmm yyyy HH:mm") & "Z | Not a completeness check")

