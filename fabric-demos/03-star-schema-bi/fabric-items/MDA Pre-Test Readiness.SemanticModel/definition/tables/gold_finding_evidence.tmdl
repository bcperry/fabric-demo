table gold_finding_evidence
	lineageTag: fe78d2e9-9547-40f7-b143-839b09844cf0
	sourceLineageTag: [dbo].[gold_finding_evidence]

	measure 'Open Findings' = ```
			CALCULATE(
			    DISTINCTCOUNT(gold_finding_evidence[finding_id]),
			    gold_finding_evidence[finding_status] = "OPEN"
			)
			```
		formatString: 0

	measure 'Evidence Records' = COUNTROWS(gold_finding_evidence)
		formatString: 0

	column finding_id
		dataType: string
		lineageTag: 58cb5ab2-df1e-47a0-8f9e-ad4e2743d8e4
