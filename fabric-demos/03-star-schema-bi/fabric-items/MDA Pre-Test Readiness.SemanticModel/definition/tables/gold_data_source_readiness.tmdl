table gold_data_source_readiness
	lineageTag: daf6edaf-056b-4b38-8c13-9e33a8c704d4
	sourceLineageTag: [dbo].[gold_data_source_readiness]

	measure 'Required Feeds' = DISTINCTCOUNT(gold_data_source_readiness[required_feed_id])
		formatString: 0

	measure 'Available Feeds' = ```
			CALCULATE(
			    DISTINCTCOUNT(gold_data_source_readiness[required_feed_id]),
			    gold_data_source_readiness[required_feed_status] = "AVAILABLE"
			)
			```
		formatString: 0

	measure 'Missing Feeds' = ```
			CALCULATE(
			    DISTINCTCOUNT(gold_data_source_readiness[required_feed_id]),
			    gold_data_source_readiness[required_feed_status] = "MISSING"
			)
			```
		formatString: 0

